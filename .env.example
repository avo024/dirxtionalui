# DiRxctional frontend env — copy to .env and fill in.
# ⚠️ ALL VITE_* vars are compiled into the PUBLIC JS bundle. NEVER put a real
# secret (client secret, API key, Stripe key) behind a VITE_ prefix — it ships
# to every browser. The values below are public-by-design Cognito/API config.

VITE_API_URL=/api
VITE_COGNITO_REGION=us-east-2
VITE_COGNITO_USER_POOL_ID=us-east-2_xxxxxxxxx
VITE_COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_COGNITO_DOMAIN=your-domain.auth.us-east-2.amazoncognito.com
